{
  "manifest_version": 3,
  "name": "College Helper",
  "version": "1.0.0",
  "description": "Store your college application info locally and autofill it into forms with one click. 100% offline.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],

  "background": {
    "service_worker": "shared/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/constants.js", "shared/utils.js", "content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
